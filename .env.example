# Runtime
APP_NAME=Mecatronix
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
# Public URL of this API. Used for links in emails (newsletter unsubscribe) and pages.
API_URL=https://api.mecatronix.com
# API docs at /mec-api/docs. Defaults to on outside production, off in production.
SWAGGER_ENABLED=

# PostgreSQL
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/mecatronix
DB_SSL=false
# Optional CA certificate for verified TLS (e.g. Aiven's ca.pem): a file path or the PEM text with \n line breaks.
# Without it, DB_SSL=true encrypts the connection but does not verify the server certificate.
DB_SSL_CA=
DB_SYNCHRONIZE=false
DB_LOGGING=false
DATABASE_CONNECTION_LIMIT=10

# Authentication
JWT_SECRET=generate-a-random-secret-with-at-least-32-characters
JWT_EXPIRES_IN=1h
COOKIE_MAX_AGE_MS=3600000
COOKIE_DOMAIN=
BCRYPT_SALT_ROUNDS=12

# Superadmin seed (npm run seed:superadmin). Safe to re-run: it creates the account,
# promotes an existing admin with this email, or does nothing if it already exists.
SUPERADMIN_NAME=Mecatronix Owner
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_PHONE=0000000000
SUPERADMIN_PASSWORD=change-me-to-a-strong-password
# Set to true for one run to overwrite the existing superadmin's password with SUPERADMIN_PASSWORD.
SUPERADMIN_RESET_PASSWORD=false

# Allowed applications (CORS). ADMIN_URL is also used for login and password-reset links.
LOCAL_URL=http://localhost:5173
CLIENT_URL=https://mecatronix.com
ADMIN_URL=https://admin.mecatronix.com
# Where password-reset emails point; the token is appended. Defaults to ${ADMIN_URL}/reset-password.
# To use the API's built-in reset page instead: ${API_URL}/mec-api/auth/reset-password
RESET_PASSWORD_URL=

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_PUBLIC_URL=https://cdn.example.com
MAX_FILE_SIZE_BYTES=10485760
MAX_UPLOAD_FILES=10

# Resend (email is disabled, with a warning, while RESEND_API_KEY is empty)
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=Mecatronix <noreply@example.com>
ADMIN_EMAIL=admin@example.com

# Request limits (global default; login, contact and newsletter endpoints have stricter limits)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# End-to-end tests only (npm run test:e2e). Must be a separate, disposable database.
TEST_DATABASE_URL=
