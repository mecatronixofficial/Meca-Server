<%# Callout box. Params: text, heading (optional), tone: 'info' | 'warning' | 'success'. %>
<% var palette = { info: ['#eff6ff', '#2563eb'], warning: ['#fffbeb', '#d97706'], success: ['#ecfdf5', '#059669'] }[locals.tone || 'info']; %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0;">
  <tr>
    <td style="padding:14px 18px;background:<%= palette[0] %>;border-left:4px solid <%= palette[1] %>;border-radius:8px;font-size:14px;line-height:1.6;color:#334155;">
      <% if (locals.heading) { %><strong style="display:block;margin-bottom:4px;color:#0f172a;"><%= heading %></strong><% } %>
      <%= text %>
    </td>
  </tr>
</table>
