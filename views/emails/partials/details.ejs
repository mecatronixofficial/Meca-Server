<%# Label/value table. Params: rows = [[label, value, mono?], ...]. Empty values show as "N/A". %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0;border:1px solid #e2e8f0;border-radius:12px;background:#f8fafc;border-collapse:separate;">
  <% rows.forEach(function (row, index) { var border = index ? 'border-top:1px solid #e2e8f0;' : ''; %>
    <tr>
      <td valign="top" style="padding:12px 16px;width:36%;font-size:13px;color:#64748b;<%= border %>"><%= row[0] %></td>
      <td valign="top" style="padding:12px 16px;font-size:14px;font-weight:600;color:#0f172a;word-break:break-word;<%= border %><%= row[2] ? 'font-family:Consolas,Menlo,monospace;' : '' %>"><%= row[1] || 'N/A' %></td>
    </tr>
  <% }) %>
</table>
