<%# Sent when a superadmin sets a new password for an admin. Data: name, email, password, loginUrl %>
<%- include('partials/header', { title: 'Your admin password was updated', preheader: 'A superadmin set a new password for your admin account.', eyebrow: 'Security Center' }) %>
<h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#0f172a;">Your password was updated</h1>
<p style="margin:0 0 12px;">Hi <%= name %>, a superadmin has set a new password for your <strong><%= brand.name %></strong> admin account.</p>
<%- include('partials/details', { rows: [
  ['Email', email],
  ['New password', password, true],
] }) %>
<%- include('partials/button', { href: loginUrl, label: 'Sign in to the admin panel' }) %>
<%- include('partials/notice', { tone: 'warning', heading: 'Keep your account secure', text: 'Change this password after you sign in. If you did not expect this change, contact your superadmin immediately.' }) %>
<%- include('partials/footer', { note: 'This is an automated security message. Please do not reply.' }) %>
