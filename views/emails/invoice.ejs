<%# Data: invoice, invoiceDate, dueDate, total (pre-formatted) %>
<% var money = function (value) { return 'INR ' + Number(value).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }; %>
<%- include('partials/header', { title: 'Invoice ' + invoice.invoiceNo, preheader: 'Invoice ' + invoice.invoiceNo + ' for INR ' + total + (dueDate ? ', due ' + dueDate : ''), eyebrow: 'Invoice' }) %>
<p style="margin:0 0 12px;">Hello <strong><%= invoice.clientName %></strong>,</p>
<p style="margin:0 0 12px;">Your invoice from <strong><%= brand.name %></strong> is ready. Here is a summary.</p>
<%- include('partials/details', { rows: [
  ['Invoice no.', invoice.invoiceNo, true],
  ['Invoice date', invoiceDate],
  ['Due date', dueDate],
  ['Amount due', 'INR ' + total],
] }) %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 20px;border-collapse:collapse;">
  <tr>
    <th align="left" style="padding:10px 12px;background:#0f172a;color:#ffffff;font-size:11px;letter-spacing:1px;text-transform:uppercase;">Description</th>
    <th align="center" style="padding:10px 12px;background:#0f172a;color:#ffffff;font-size:11px;letter-spacing:1px;text-transform:uppercase;">Qty</th>
    <th align="right" style="padding:10px 12px;background:#0f172a;color:#ffffff;font-size:11px;letter-spacing:1px;text-transform:uppercase;">Rate</th>
    <th align="right" style="padding:10px 12px;background:#0f172a;color:#ffffff;font-size:11px;letter-spacing:1px;text-transform:uppercase;">Amount</th>
  </tr>
  <% invoice.items.forEach(function (item) { %>
    <tr>
      <td style="padding:10px 12px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#334155;"><%= item.desc %></td>
      <td align="center" style="padding:10px 12px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#334155;"><%= item.qty %></td>
      <td align="right" style="padding:10px 12px;border-bottom:1px solid #e2e8f0;font-size:13px;color:#334155;white-space:nowrap;"><%= money(item.rate) %></td>
      <td align="right" style="padding:10px 12px;border-bottom:1px solid #e2e8f0;font-size:13px;font-weight:700;color:#0f172a;white-space:nowrap;"><%= money(item.amount) %></td>
    </tr>
  <% }) %>
  <tr>
    <td colspan="3" align="right" style="padding:14px 12px 4px;font-size:14px;font-weight:700;color:#0f172a;">Total</td>
    <td align="right" style="padding:14px 12px 4px;font-size:16px;font-weight:800;color:#0f172a;white-space:nowrap;">INR <%= total %></td>
  </tr>
</table>
<% if (invoice.notes) { %><%- include('partials/notice', { tone: 'info', heading: 'Notes', text: invoice.notes }) %><% } %>
<p style="margin:20px 0 8px;font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#64748b;">Payment details</p>
<%- include('partials/details', { rows: [
  ['Bank', 'Indian Bank'],
  ['Account name', 'Manikandan P'],
  ['Account no.', '6540068368', true],
  ['IFSC', 'IDIB000K185', true],
  ['UPI', 'manipkm0004@okhdfcbank', true],
] }) %>
<p style="margin:0;font-size:14px;color:#64748b;">Questions about this invoice? Just reply to this email.</p>
<%- include('partials/footer', { note: 'Thank you for your business.' }) %>
