<%# Data: name, email, role, supportEmail, contactUrl %>
<%- include('partials/header', { title: 'Your admin account was removed', preheader: 'Your ' + brand.name + ' admin account has been deleted.', eyebrow: 'Account Services' }) %>
<h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#0f172a;">Your admin account was removed</h1>
<p style="margin:0 0 12px;">Hi <%= name %>, your <strong><%= brand.name %></strong> admin account has been deleted by a superadmin. You can no longer sign in to the admin panel with it.</p>
<%- include('partials/details', { rows: [
  ['Email', email],
  ['Previous access level', role === 'superadmin' ? 'Superadmin' : 'Admin'],
] }) %>
<%- include('partials/notice', { tone: 'info', heading: 'Think this is a mistake?', text: 'Get in touch and we will look into it.' + (supportEmail ? ' Email ' + supportEmail + '.' : '') }) %>
<% if (contactUrl) { %><%- include('partials/button', { href: contactUrl, label: 'Contact us' }) %><% } %>
<%- include('partials/footer', { note: 'This is an automated account notification.' }) %>
