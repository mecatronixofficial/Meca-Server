<%# Acknowledgement to the person who sent an enquiry. Data: name, message, enquiryId %>
<%- include('partials/header', { title: 'We received your message', preheader: 'Thanks for contacting ' + brand.name + '. We will get back to you soon.', eyebrow: brand.tagline }) %>
<h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#0f172a;">Thanks for reaching out<%= name ? ', ' + name : '' %>!</h1>
<p style="margin:0 0 12px;">We've received your message and our team is reviewing it. You can expect a reply within <strong>1–2 business days</strong>.</p>
<p style="margin:20px 0 8px;font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#64748b;">Your message</p>
<div style="padding:16px 18px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;font-size:15px;line-height:1.7;color:#0f172a;white-space:pre-wrap;"><%= message %></div>
<% if (locals.enquiryId) { %><p style="margin:16px 0 0;font-size:13px;color:#64748b;">Reference: <span style="font-family:Consolas,Menlo,monospace;"><%= enquiryId %></span></p><% } %>
<%- include('partials/button', { href: brand.website, label: 'Visit our website' }) %>
<%- include('partials/footer', { note: 'You received this email because you contacted us through our website.' }) %>
