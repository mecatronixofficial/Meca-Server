<%# Welcome email for new newsletter subscribers. Data: unsubscribeUrl %>
<%- include('partials/header', { title: 'Welcome to the ' + brand.name + ' newsletter', preheader: "You're subscribed! Here's what to expect.", eyebrow: brand.tagline }) %>
<h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#0f172a;">You're subscribed!</h1>
<p style="margin:0 0 16px;">Thanks for joining the <strong><%= brand.name %></strong> newsletter. Here's what you'll get:</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 8px;">
  <% [
    ['🚀', 'Project launches', 'New work and case studies as soon as they go live.'],
    ['💡', 'Insights', 'Practical ideas on web, software and automation.'],
    ['🎁', 'Exclusive offers', 'Subscriber-only vouchers and early access.'],
  ].forEach(function (item) { %>
    <tr>
      <td valign="top" style="width:44px;padding:10px 0;font-size:22px;"><%= item[0] %></td>
      <td valign="top" style="padding:10px 0;">
        <strong style="display:block;color:#0f172a;"><%= item[1] %></strong>
        <span style="font-size:14px;color:#64748b;"><%= item[2] %></span>
      </td>
    </tr>
  <% }) %>
</table>
<%- include('partials/notice', { tone: 'info', heading: 'Never miss an update', text: 'Add ' + brand.name + ' to your contacts. Gmail users: check the Promotions tab and move us to Primary.' }) %>
<%- include('partials/button', { href: brand.website, label: 'Explore our work' }) %>
<%- include('partials/footer', {}) %>
