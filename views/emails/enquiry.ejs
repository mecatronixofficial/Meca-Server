<%# Team notification for a new contact-form enquiry. Data: enquiryId, name, email, phone, company, message, timestamp, adminUrl %>
<%- include('partials/header', { title: 'New enquiry from ' + (name || email), preheader: (name || email) + ': ' + String(message).slice(0, 90), eyebrow: 'New Enquiry' }) %>
<h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#0f172a;">New enquiry received</h1>
<p style="margin:0 0 12px;">Someone submitted the contact form on the website. Reply to this email to respond to them directly.</p>
<%- include('partials/details', { rows: [
  ['Name', name],
  ['Email', email],
  ['Phone', phone],
  ['Company', company],
  ['Received', timestamp],
  ['Reference', enquiryId, true],
] }) %>
<p style="margin:20px 0 8px;font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#64748b;">Message</p>
<div style="padding:16px 18px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;font-size:15px;line-height:1.7;color:#0f172a;white-space:pre-wrap;"><%= message %></div>
<% if (locals.adminUrl) { %><%- include('partials/button', { href: adminUrl, label: 'Open in admin panel' }) %><% } %>
<%- include('partials/footer', { note: 'Sent automatically from the website contact form.' }) %>
