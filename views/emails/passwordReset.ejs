<%# Data: resetLink, expiresInMinutes %>
<%- include('partials/header', { title: 'Reset your password', preheader: 'Use this link to choose a new password. It expires soon.', eyebrow: 'Security Center' }) %>
<h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#0f172a;">Reset your password</h1>
<p style="margin:0 0 12px;">We received a request to reset the password for your <strong><%= brand.name %></strong> admin account. Click the button below to choose a new one.</p>
<%- include('partials/button', { href: resetLink, label: 'Choose a new password' }) %>
<%- include('partials/notice', { tone: 'warning', heading: 'This link expires in ' + (locals.expiresInMinutes || 10) + ' minutes', text: 'It can be used only once. If it has expired, request a new reset email from the sign-in page.' }) %>
<p style="margin:0;font-size:14px;color:#64748b;">Didn't ask for this? You can safely ignore this email. Your password won't change.</p>
<%- include('partials/footer', { note: 'This is an automated security message. Please do not reply.' }) %>
