<%# Campaign / voucher email to subscribers. Data: title, heading, message, images[], websiteUrl, unsubscribeUrl %>
<%- include('partials/header', { title: title, preheader: heading || message || title, eyebrow: brand.tagline }) %>
<h1 style="margin:0 0 12px;font-size:24px;line-height:1.3;color:#0f172a;"><%= title %></h1>
<% if (heading) { %><p style="margin:0 0 12px;font-size:17px;font-weight:700;color:#0f766e;"><%= heading %></p><% } %>
<% if (message) { %><p style="margin:0 0 16px;white-space:pre-wrap;"><%= message %></p><% } %>
<% (images || []).forEach(function (image, index) { %>
  <img src="<%= image %>" alt="<%= title %> image <%= index + 1 %>" width="536" style="display:block;width:100%;max-width:536px;height:auto;margin:0 0 14px;border:0;border-radius:12px;" />
<% }) %>
<%- include('partials/button', { href: websiteUrl || brand.website, label: 'Explore now' }) %>
<%- include('partials/footer', {}) %>
