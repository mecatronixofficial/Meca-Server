<%# Security alert after an admin changes their own password. Data: name, timestamp, resetUrl %>
<%- include('partials/header', { title: 'Your password was changed', preheader: 'The password for your admin account was just changed.', eyebrow: 'Security Center' }) %>
<h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#0f172a;">Your password was changed</h1>
<p style="margin:0 0 12px;">Hi <%= name %>, the password for your <strong><%= brand.name %></strong> admin account was changed on <strong><%= timestamp %></strong>.</p>
<%- include('partials/notice', { tone: 'success', heading: 'Was this you?', text: 'If you made this change, no action is needed.' }) %>
<p style="margin:0 0 12px;">If you did <strong>not</strong> change your password, use <strong>Forgot password</strong> on the sign-in page to reset it now, and let your superadmin know.</p>
<%- include('partials/button', { href: resetUrl, label: 'Go to sign-in' }) %>
<%- include('partials/footer', { note: 'This is an automated security message. Please do not reply.' }) %>
