<%# Data: timestamp, loginUrl %>
<%- include('partials/header', { title: 'Your password has been reset', preheader: 'Your password was reset successfully.', eyebrow: 'Security Center' }) %>
<h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#0f172a;">Your password has been reset</h1>
<p style="margin:0 0 12px;">The password for your <strong><%= brand.name %></strong> admin account was reset on <strong><%= timestamp %></strong>. You can now sign in with your new password.</p>
<% if (locals.loginUrl) { %><%- include('partials/button', { href: loginUrl, label: 'Sign in' }) %><% } %>
<%- include('partials/notice', { tone: 'warning', heading: "Didn't reset your password?", text: 'Someone may have access to your email. Request a new reset right away and contact your superadmin.' }) %>
<%- include('partials/footer', { note: 'This is an automated security message. Please do not reply.' }) %>
