<%# Password reset form. Data: actionUrl, minLength, error (optional) %>
<%- include('partials/top', { title: 'Reset password', eyebrow: 'Security Center' }) %>
<h1>Choose a new password</h1>
<p>Enter a new password for your admin account. This link can be used only once.</p>
<% if (locals.error) { %><div class="alert" role="alert"><%= error %></div><% } %>
<form method="post" action="<%= actionUrl %>">
  <label for="password">New password</label>
  <input id="password" name="password" type="password" autocomplete="new-password" minlength="<%= minLength %>" required autofocus />
  <p class="hint">At least <%= minLength %> characters.</p>
  <label for="confirmPassword">Confirm new password</label>
  <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="<%= minLength %>" required />
  <button class="btn" type="submit">Reset password</button>
</form>
<%- include('partials/bottom') %>
