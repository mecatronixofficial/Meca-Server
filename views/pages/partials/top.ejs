<%# Shared page shell. Params: title. `brand` comes from app locals (see app.setup.ts). %><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title><%= title %> · <%= brand.name %></title>
  <style>
    :root {
      --bg: #f1f5f9; --card: #ffffff; --text: #0f172a; --muted: #64748b; --border: #dbe4ee;
      --brand: #2563eb; --brand-2: #0f766e; --brand-3: #14b8a6; --danger: #dc2626; --ok: #059669;
      --field: #f8fafc;
    }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #0b1120; --card: #111827; --text: #e2e8f0; --muted: #94a3b8; --border: #1f2a3c; --field: #0f172a; --brand: #3b82f6; }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px 16px;
      background: var(--bg); color: var(--text);
      font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    }
    .card { width: 100%; max-width: 480px; background: var(--card); border: 1px solid var(--border); border-radius: 18px; overflow: hidden; box-shadow: 0 20px 45px rgba(15, 23, 42, .08); }
    .bar { height: 5px; background: linear-gradient(90deg, var(--brand), var(--brand-2), var(--brand-3)); }
    .inner { padding: 32px; }
    .logo { margin: 0 0 4px; font-size: 22px; font-weight: 800; letter-spacing: 3px; }
    .logo a { color: inherit; text-decoration: none; }
    .eyebrow { margin: 0 0 24px; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--brand-3); }
    h1 { margin: 0 0 8px; font-size: 22px; line-height: 1.3; }
    p { margin: 0 0 16px; color: var(--muted); }
    p strong { color: var(--text); }
    .icon { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; margin-bottom: 16px; font-size: 24px; font-weight: 700; }
    .icon.success { background: rgba(5, 150, 105, .12); color: var(--ok); }
    .icon.error { background: rgba(220, 38, 38, .12); color: var(--danger); }
    .icon.info { background: rgba(37, 99, 235, .12); color: var(--brand); }
    label { display: block; margin: 0 0 6px; font-size: 14px; font-weight: 600; }
    input[type=password] {
      width: 100%; margin-bottom: 16px; padding: 12px 14px; font: inherit; color: var(--text);
      background: var(--field); border: 1px solid var(--border); border-radius: 10px;
    }
    input[type=password]:focus { outline: 2px solid var(--brand); outline-offset: 1px; }
    .hint { margin: -10px 0 16px; font-size: 13px; }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; width: 100%; padding: 13px 20px; border: 0; border-radius: 10px;
      background: var(--brand); color: #fff; font: inherit; font-weight: 700; text-decoration: none; cursor: pointer;
    }
    .btn:hover { filter: brightness(1.08); }
    .btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }
    .btn.secondary { margin-top: 10px; background: transparent; color: var(--brand); border: 1px solid var(--border); }
    .btn.danger { background: var(--danger); }
    .alert { margin: 0 0 16px; padding: 12px 14px; border-radius: 10px; background: rgba(220, 38, 38, .1); color: var(--danger); font-size: 14px; }
    .links { display: grid; gap: 10px; margin: 8px 0 0; padding: 0; list-style: none; }
    .links a { display: flex; justify-content: space-between; padding: 12px 14px; border: 1px solid var(--border); border-radius: 10px; color: var(--text); text-decoration: none; }
    .links a:hover { border-color: var(--brand); }
    .links span { color: var(--muted); font-size: 14px; }
    .pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; }
    .pill::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
    .pill.up { background: rgba(5, 150, 105, .12); color: var(--ok); }
    .pill.down { background: rgba(220, 38, 38, .12); color: var(--danger); }
    .meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 20px; }
    .foot { padding: 16px 32px; border-top: 1px solid var(--border); font-size: 13px; color: var(--muted); text-align: center; }
    .foot a { color: var(--brand); text-decoration: none; }
    @media (max-width: 480px) { .inner { padding: 24px 20px; } .foot { padding: 14px 20px; } }
  </style>
</head>
<body>
  <main class="card">
    <div class="bar"></div>
    <div class="inner">
      <p class="logo"><a href="<%= brand.website %>"><%= brand.name %></a></p>
      <p class="eyebrow"><%= locals.eyebrow || brand.tagline %></p>
